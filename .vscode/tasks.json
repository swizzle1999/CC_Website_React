{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "path": "cc_website_react.client/",
      "detail": "Start Vite dev server (HTTPS, HMR)",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "beginsPattern": "^.*VITE.*v\\d+\\..*$",
          "endsPattern": "^.*Local:.*https?://localhost.*$"
        }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "path": "cc_website_react.client/",
      "detail": "Generate posts + Vite production build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "path": "cc_website_react.client/",
      "detail": "Run ESLint",
      "group": "build",
      "problemMatcher": ["$eslint-compact"]
    },
    {
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "path": "cc_website_react.client/",
      "detail": "Preview production build locally",
      "problemMatcher": []
    },
    {
      "label": "deploy",
      "type": "npm",
      "script": "deploy",
      "path": "cc_website_react.client/",
      "detail": "Build + deploy to GitHub Pages",
      "problemMatcher": []
    }
  ]
}
